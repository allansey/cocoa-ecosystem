generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id         String   @id @default(uuid())
  chatId     String
  senderId   String
  senderName String
  text       String
  audioUrl   String?
  createdAt  DateTime @default(now())
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      String    @default("BUYER") // FARMER, BUYER
  name      String
  phone     String?
  createdAt DateTime  @default(now())
  
  listings  Listing[]
  orders    Order[]   @relation("BuyerOrders")
  sales     Order[]   @relation("FarmerSales")
  reviews   Review[]
  readings  SensorReading[]
  buyerOffers  Offer[] @relation("BuyerOffers")
  farmerOffers Offer[] @relation("FarmerOffers")
}

model Listing {
  id               String        @id @default(uuid())
  grade            String
  quantityKg       Float
  priceGhsPerTonne Float
  region           String
  photo            String?       // SQLite doesn't support String[]
  status           String        @default("AVAILABLE") // AVAILABLE, SOLD
  farmerId         String
  
  // Cocoa Quality Passport Fields
  moistureLevel    Float?        // e.g. 6.8%
  aiHealthScore    Float?        // e.g. 98.5%
  diseaseStatus    String?       // healthy, black_pod_rot, frosty_pod_rot
  harvestDate      DateTime?
  
  createdAt        DateTime      @default(now())
  
  farmer           User          @relation(fields: [farmerId], references: [id])
  orders           Order[]
  offers           Offer[]
}

model Offer {
  id               String   @id @default(uuid())
  listingId        String
  buyerId          String
  farmerId         String
  priceGhsPerTonne Float
  quantityKg       Float
  totalAmount      Float
  status           String   @default("PENDING") // PENDING, ACCEPTED, DECLINED, COUNTERED
  counterPrice     Float?
  counterQuantity  Float?
  note             String?
  chatId           String?
  orderId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  listing          Listing  @relation(fields: [listingId], references: [id])
  buyer            User     @relation("BuyerOffers", fields: [buyerId], references: [id])
  farmer           User     @relation("FarmerOffers", fields: [farmerId], references: [id])
}

model Order {
  id            String          @id @default(uuid())
  listingId     String
  buyerId       String
  farmerId      String
  quantityKg    Float
  totalAmount   Float
  proposedPrice Float?
  status        String          @default("PENDING_APPROVAL") // PENDING_APPROVAL, ACCEPTED, PAYMENT_PENDING, PAID, IN_TRANSIT, DELIVERED, COMPLETED, CANCELLED, DISPUTED
  paymentMethod String          @default("COD") // MOMO, CARD, CASH, COD
  chatId        String?

  // Delivery & Recipient Details
  deliveryAddress String?
  deliveryCity    String?
  deliveryRegion  String?
  recipientName   String?
  recipientPhone  String?
  deliveryNotes   String?

  // Financial Breakdown
  subtotal        Float?
  deliveryFee     Float?         @default(0)
  serviceFee      Float?         @default(0)

  // Logistics & Transporter Info
  transporterName String?
  transporterPhone String?
  vehicleNumber   String?
  trackingNumber  String?
  estimatedDeliveryDate String?
  loadingProofPhoto String?
  weighbridgeReceipt String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  listing       Listing         @relation(fields: [listingId], references: [id])
  buyer         User            @relation("BuyerOrders", fields: [buyerId], references: [id])
  farmer        User            @relation("FarmerSales", fields: [farmerId], references: [id])
  review        Review?
  activities    OrderActivity[]
}

model OrderActivity {
  id        String   @id @default(uuid())
  orderId   String
  actorId   String
  actorName String
  actorRole String
  action    String
  note      String?
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id])
}

model Review {
  id           String   @id @default(uuid())
  orderId      String   @unique
  userId       String   // Reviewer
  targetUserId String?  // User being reviewed
  rating       Int      @default(5)
  comment      String?
  badges       String?  // e.g. "Top Quality,Fast Payment"
  createdAt    DateTime @default(now())

  order        Order    @relation(fields: [orderId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model SensorReading {
  id            String   @id @default(uuid())
  userId        String   // Farmer ID
  soilMoisture  Float
  temperature   Float
  humidity      Float
  createdAt     DateTime @default(now())

  farmer        User     @relation(fields: [userId], references: [id])
}
