# ==============================================================================
# CocoaLink Ghana - Frontend Production Environment Configuration
# ==============================================================================

# 1. Express Backend REST API
# When deploying the backend (e.g. on Render, Railway, AWS, or DigitalOcean),
# set this to the live HTTPS URL of your Express server ending in /api:
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# 2. Python YOLOv8 Image Inference Server (Port 5002 locally)
# Set this to the live HTTPS URL of your Python YOLO server:
NEXT_PUBLIC_AI_IMAGE_SERVER_URL=https://your-yolo-server.onrender.com

# 3. Python Voice + AI Advisor Server (Port 5001 locally)
# Set this to the live HTTPS URL of your Python Voice/Khaya/MMS-TTS server:
NEXT_PUBLIC_VOICE_SERVER_URL=https://your-voice-server.onrender.com

# 4. Firebase Realtime Chat & Push Notifications (Optional / If configured)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
